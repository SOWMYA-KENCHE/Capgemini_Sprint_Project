<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Cross Browser Suite" parallel="tests"
       thread-count="3">

    <test name="Chrome">
        <parameter name="browser" value="chrome"/>
        <packages>
            <package name="ecom.swaglabs.CheckoutPage"/>
            <package name="ecom.swaglabs.Login"/>
            <package name="ecom.swaglabs.ProductPage"/>
            <package name="ecom.swaglabs.Shopping_cart"/>
        </packages>
    </test>
     
    <test name="Firefox">
        <parameter name="browser" value="firefox"/>
        <packages>
            <package name="ecom.swaglabs.CheckoutPage"/>
            <package name="ecom.swaglabs.Login"/>
            <package name="ecom.swaglabs.ProductPage"/>
            <package name="ecom.swaglabs.Shopping_cart"/>
        </packages>
    </test>

</suite>

